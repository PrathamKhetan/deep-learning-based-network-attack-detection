{
  "version": 2,
  "builds": [
    {
      "src": "ndr-frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "https://dashboard.render.com/web/srv-dbe5shoae00c73eqed8g/api/v1/$1" }
  ],
  "env": {
    "VITE_BACKEND_URL": "https://dashboard.render.com/web/srv-dbe5shoae00c73eqed8g"
  }
}
